# The versions of the tools CI downloads (Roadmap Phase 97). Nothing in a workflow may fetch "latest" or run an install
# script from a moving branch: a security gate has to run what was reviewed, and a build has to be reproducible
# (TestWorkflowsInstallNothingUnpinned fails the build if one comes back).
#
# To update a tool: change its version here, and for k3d and Helm also the sha256 of the binary for linux/amd64
# (k3d: checksums.txt of the release; Helm: https://get.helm.sh/helm-v<version>-linux-amd64.tar.gz.sha256sum).
# .github/scripts/install-tools.sh checks the downloaded file against these hashes, not against a hash it downloaded itself.
# Helm's version matches the SDK in backend/go.mod (helm.sh/helm/v3), so the CLI and Vinaire render charts the same way.

K3D_VERSION=5.9.0
K3D_SHA256_LINUX_AMD64=06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0

HELM_VERSION=3.22.1
HELM_SHA256_LINUX_AMD64=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea

# Go tools, installed with `go install <module>@v<version>` (the module proxy's checksum database verifies the source).
GOVULNCHECK_VERSION=1.9.0
GOSEC_VERSION=2.30.0
