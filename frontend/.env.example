# Copy to .env.local and fill in — see /keycloak's README for the dev
# Keycloak instance these Keycloak values point at by default. These are
# the values for running the frontend natively (npm run dev). If you run it
# containerized instead (docker-compose.dev.yml), that file overrides
# AUTH_KEYCLOAK_ISSUER — see auth.ts's top comment for why.

# Any random string; `npx auth secret` generates one.
AUTH_SECRET=
AUTH_URL=http://localhost:3100

AUTH_KEYCLOAK_ID=vinaire-frontend
AUTH_KEYCLOAK_SECRET=vinaire-frontend-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/vinaire-dev
AUTH_KEYCLOAK_AUTHORIZATION_URL=http://localhost:8180/realms/vinaire-dev/protocol/openid-connect/auth
